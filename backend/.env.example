# Copy to .env and adjust. Values below match docker-compose.yml.
PIT_ENV=local
PIT_DATABASE_URL=postgresql+psycopg://pit:pit@localhost:5433/pit
PIT_REDIS_URL=redis://localhost:6380/0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PIT_DAILY_CODE_SECRET=change-me
PIT_S3_ENDPOINT_URL=http://localhost:9100
PIT_S3_BUCKET=proofs
PIT_S3_ACCESS_KEY=pit
PIT_S3_SECRET_KEY=pit-secret-key
# local (disk, dev) | s3 (production)
PIT_STORAGE=local
PIT_LOCAL_STORAGE_DIR=.storage
PIT_PUBLIC_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PIT_JWT_SECRET=change-me-too
# dev | openai | azure  (dev: no AI, proofs auto-approved, template plans)
# true: no Celery needed locally; set false in production and run the worker + beat
PIT_INLINE_TASKS=true
PIT_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]
# console (logs codes) | eskiz (real SMS, needs an eskiz.uz account)
PIT_SMS_PROVIDER=console
PIT_ESKIZ_EMAIL=
PIT_ESKIZ_PASSWORD=
PIT_ESKIZ_SENDER=4546
PIT_RATE_LIMITS_ENABLED=true
PIT_TRUST_PROXY_HEADERS=false
# Paid features (stake mode, wallet). false = the whole platform is free.
PIT_STAKES_ENABLED=false

# Telegram bot (optional). Locally "polling" works without a public URL:
# create a test bot with @BotFather, fill both values and restart the API.
PIT_WEB_URL=http://localhost:3100
PIT_TELEGRAM_BOT_TOKEN=
PIT_TELEGRAM_BOT_USERNAME=
PIT_TELEGRAM_MODE=polling

# "Sign in with Google" (optional): OAuth Web client id with http://localhost:3100 as an
# authorized JavaScript origin.
PIT_GOOGLE_CLIENT_ID=

# AI providers in turn order; empty = no AI (proofs auto-approved, template plans).
# They take turns, and a busy or rate-limited one hands the request to the next.
# Both have free tiers: aistudio.google.com (Gemini), console.groq.com (Groq).
# Check that they really answer: uv run python -m pit.cli ai-check
PIT_AI_PROVIDERS=
PIT_GEMINI_API_KEY=
PIT_GEMINI_MODEL=gemini-3.7-flash
PIT_GROQ_API_KEY=
PIT_GROQ_MODEL=qwen/qwen3.8-27b
PIT_GROQ_PLAN_MODEL=openai/gpt-oss-120b
