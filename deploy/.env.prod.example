# Copy to deploy/.env.prod and fill in. Never commit the real file.
# Secrets: python -c "import secrets; print(secrets.token_hex(32))"

DOMAIN=pit.uz
POSTGRES_PASSWORD=

PIT_ENV=production
PIT_DAILY_CODE_SECRET=
PIT_JWT_SECRET=
PIT_PUBLIC_BASE_URL=https://pit.uz
PIT_CORS_ORIGINS=["https://pit.uz"]

# Proof photos on the server disk (volume "storage"). For several servers use S3:
PIT_STORAGE=local
# PIT_STORAGE=s3
# PIT_S3_ENDPOINT_URL=
# PIT_S3_BUCKET=
# PIT_S3_ACCESS_KEY=
# PIT_S3_SECRET_KEY=

PIT_WEB_URL=https://pit.uz

# Telegram bot: create it with @BotFather. Leave the token empty to run without a bot.
# The webhook ({PIT_PUBLIC_BASE_URL}/api/v1/telegram/webhook) is registered on every deploy.
PIT_TELEGRAM_BOT_TOKEN=
PIT_TELEGRAM_BOT_USERNAME=
PIT_TELEGRAM_WEBHOOK_SECRET=
PIT_TELEGRAM_MODE=webhook

# "Sign in with Google": OAuth Web client id (Google Cloud Console → Credentials).
# Authorized JavaScript origin: https://pit.uz. Leave empty to hide the Google button.
PIT_GOOGLE_CLIENT_ID=

# Paid features (stake mode, wallet): enable later, after Payme/Click and legal review.
PIT_STAKES_ENABLED=false

PIT_INLINE_TASKS=false
PIT_TRUST_PROXY_HEADERS=true
PIT_RATE_LIMITS_ENABLED=true

# Phones are verified through the Telegram bot for free; SMS is an optional fallback.
# console = off (the SMS form is hidden), eskiz = real SMS.
PIT_SMS_PROVIDER=console
PIT_ESKIZ_EMAIL=
PIT_ESKIZ_PASSWORD=
PIT_ESKIZ_SENDER=4546

# AI providers in turn order (gemini, groq, openai, azure). They take turns and cover for each
# other when one is busy or rate-limited. Empty = no AI: every proof is approved — never here.
# Free tiers may use the data to improve the provider's models: enable billing before real
# users (children's photos!). Check after deploy:
#   docker compose -f docker-compose.prod.yml run --rm migrate python -m pit.cli ai-check
PIT_AI_PROVIDERS=gemini,groq
PIT_GEMINI_API_KEY=
PIT_GEMINI_MODEL=gemini-3.7-flash
PIT_GROQ_API_KEY=
PIT_GROQ_MODEL=qwen/qwen3.8-27b
PIT_GROQ_PLAN_MODEL=openai/gpt-oss-120b
# PIT_OPENAI_API_KEY=
# PIT_AZURE_API_KEY=  PIT_AZURE_ENDPOINT=  PIT_AZURE_DEPLOYMENT=

# Error tracking: create a free project on sentry.io (platform: Python/FastAPI) and paste its DSN.
PIT_SENTRY_DSN=
