# The free setup (docker-compose.lite.yml): this server serves only the API; the website is on
# Vercel and calls it across origins (PIT_CORS_ORIGINS).
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:8000
}
